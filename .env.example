# Exemplo para desenvolvimento. Carregue com node --env-file=.env server.mjs
# ou exporte somente as variáveis que a instalação utiliza.
NODE_ENV=development
MIKROTIK_USER=orbit-monitor
MIKROTIK_PASSWORD=

# Caminhos opcionais. Valores relativos partem do diretório de execução.
# ORBIT_CONFIG=/etc/orbit-community/config.json
# ORBIT_INVENTORY=/etc/orbit-community/inventory.json
# ORBIT_DATA_DIR=/var/lib/orbit-community
# ORBIT_COLLECTOR_KEY_FILE=/run/credentials/orbit-community.service/collector-key
# ORBIT_ENERGY_CREDENTIAL_FILE=/run/credentials/orbit-community.service/tuya-local-key
